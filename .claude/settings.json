{
    "permissions": {
        "allow": [],
        "deny": [
            "Read(./**/.env)",
            "Read(./**/*.tfvars.json)",
            "Read(./**/.terraform/**)"
        ],
        "ask": [
            "Bash(git push *)",
            "Bash(git commit *)",
            "Bash(docker *)",
            "Bash(scalingo *)",
            "Bash(scw *)"
        ]
    },
    "sandbox": {
        "excludedCommands": ["docker *"]
    }
}
